<Window x:Class="RAMView.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAM View — Settings"
        Height="460" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#F80F172A"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Settings &amp; Preferences"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>
                <Button Content="✕"
                        Width="26" Height="26"
                        Style="{StaticResource GlassButtonStyle}"
                        HorizontalAlignment="Right"
                        Padding="0"
                        Click="OnCloseClicked"/>
            </Grid>

            <!-- Settings Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <!-- Refresh Interval -->
                    <TextBlock Text="Update Cadence (Polling Interval):" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold"/>
                    <Grid Margin="0,4,0,14">
                        <Slider x:Name="sliderInterval" Minimum="250" Maximum="3000" Value="1000" TickFrequency="250" IsSnapToTickEnabled="True" Foreground="#3B82F6"/>
                        <TextBlock Text="{Binding Value, ElementName=sliderInterval, StringFormat='{}{0} ms'}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" Margin="0,18,0,0"/>
                    </Grid>

                    <!-- Opacity -->
                    <TextBlock Text="Window Glass Opacity:" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold"/>
                    <Grid Margin="0,4,0,14">
                        <Slider x:Name="sliderOpacity" Minimum="0.30" Maximum="1.0" Value="0.96" SmallChange="0.05" Foreground="#3B82F6"/>
                        <TextBlock Text="{Binding Value, ElementName=sliderOpacity, StringFormat='{}{0:P0}'}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" Margin="0,18,0,0"/>
                    </Grid>

                    <!-- Anti-dominance Share -->
                    <TextBlock Text="Anti-Dominance Max Box Share (§6):" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold"/>
                    <Grid Margin="0,4,0,14">
                        <Slider x:Name="sliderDominance" Minimum="0.30" Maximum="0.85" Value="0.60" SmallChange="0.05" Foreground="#3B82F6"/>
                        <TextBlock Text="{Binding Value, ElementName=sliderDominance, StringFormat='{}{0:P0}'}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" Margin="0,18,0,0"/>
                    </Grid>

                    <!-- Toggles -->
                    <CheckBox x:Name="chkAlwaysOnTop" Content="Always on Top (HUD Overlay)" Foreground="#E2E8F0" Margin="0,4"/>
                    <CheckBox x:Name="chkClickThrough" Content="Click-Through Mode (Pass clicks through overlay)" Foreground="#E2E8F0" Margin="0,4"/>
                    <CheckBox x:Name="chkLockPosition" Content="Lock Overlay Position (Prevent dragging)" Foreground="#E2E8F0" Margin="0,4"/>
                    <CheckBox x:Name="chkGroupProcesses" Content="Group Same-Name Process Instances" Foreground="#E2E8F0" Margin="0,4"/>
                    <CheckBox x:Name="chkShowSystem" Content="Show Windows System Processes" Foreground="#E2E8F0" Margin="0,4"/>
                    <CheckBox x:Name="chkStartWithWindows" Content="Start Automatically with Windows" Foreground="#E2E8F0" Margin="0,4"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource GlassButtonStyle}" Width="80" Margin="0,0,10,0" Click="OnCloseClicked"/>
                <Button Content="Save Settings" Style="{StaticResource GlassButtonStyle}" Background="#3B82F6" BorderBrush="#60A5FA" Width="110" Click="OnSaveClicked"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
