<UserControl x:Class="RAMView.App.Controls.TreemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:RAMView.App.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500"
             SizeChanged="OnSizeChanged">
    <Grid x:Name="LayoutRoot" ClipToBounds="True">
        <controls:AnimatedTreemapCanvas ItemsSource="{Binding TreemapItems}"
                                       ClipToBounds="True"/>
    </Grid>
</UserControl>
