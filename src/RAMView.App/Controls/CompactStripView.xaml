<UserControl x:Class="RAMView.App.Controls.CompactStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:RAMView.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="700">
    <UserControl.Resources>
        <conv:ByteArrayToImageConverter x:Key="BytesToImage" />
    </UserControl.Resources>

    <Border Background="#200B0E14" CornerRadius="8" Padding="3">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Processes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="2,0"
                                Cursor="Hand"
                                Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="stripBorder"
                                            Background="#1EFFFFFF"
                                            BorderBrush="#35FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="6,3"
                                            Height="32">
                                        <Border.ToolTip>
                                            <ToolTip Background="#F5121622" BorderBrush="#50FFFFFF" BorderThickness="1" Foreground="#FFFFFF" Padding="6,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="{Binding FormattedMemory, StringFormat='RAM: {0}'}" Foreground="#93C5FD"/>
                                                    <TextBlock Text="{Binding FormattedPercentage, StringFormat='Share: {0}'}" Foreground="#9CA3AF"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding IconPngBytes, Converter={StaticResource BytesToImage}}"
                                                   Width="14" Height="14"
                                                   Margin="0,0,4,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding ProcessName}"
                                                       Foreground="#FFFFFF"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding FormattedMemory}"
                                                       Foreground="#93C5FD"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="stripBorder" Property="Background" Value="#38FFFFFF"/>
                                            <Setter TargetName="stripBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
